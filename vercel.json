{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/#inicio",
      "permanent": true
    },
    {
      "source": "/radio",
      "destination": "/#radio",
      "permanent": false
    },
    {
      "source": "/media",
      "destination": "/#media",
      "permanent": false
    },
    {
      "source": "/donaciones",
      "destination": "/#donaciones",
      "permanent": false
    },
    {
      "source": "/donaciones/index.html",
      "destination": "/#donaciones",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/affiliate-status.json",
      "destination": "/api/site-config?name=affiliate-status"
    },
    {
      "source": "/api/content-config.json",
      "destination": "/api/site-config?name=content-config"
    },
    {
      "source": "/api/donations-config.json",
      "destination": "/api/site-config?name=donations-config"
    },
    {
      "source": "/api/forms-config.json",
      "destination": "/api/site-config?name=forms-config"
    },
    {
      "source": "/api/media-config.json",
      "destination": "/api/site-config?name=media-config"
    },
    {
      "source": "/api/radio-config.json",
      "destination": "/api/site-config?name=radio-config"
    },
    {
      "source": "/api/social-config.json",
      "destination": "/api/site-config?name=social-config"
    }
  ],
  "functions": {
    "api/wallpaper-catalog.js": {
      "includeFiles": "assets/wallpapers/{originales,afiliados}/**"
    },
    "api/wallpaper-admin.js": {
      "maxDuration": 180
    }
  },
  "buildCommand": "node scripts/build-site.cjs",
  "outputDirectory": "dist"
}
